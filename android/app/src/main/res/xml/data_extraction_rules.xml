<?xml version="1.0" encoding="utf-8"?>
<!-- 토큰이 클라우드 백업이나 기기 이전으로 다른 폰에 따라가면 안 된다. 새 폰에서는 연결 코드로 다시 붙는다 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
