# 이 파일을 .env로 복사해서 값을 채운다. .env는 절대 커밋하지 않는다.
#   cp .env.example .env

# --- DB ---
MYSQL_DATABASE=capture
MYSQL_USER=capture
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
# 호스트에 이미 MySQL이 떠 있으면 이 값만 바꾼다 (예: 3307)
MYSQL_PORT=3306

# --- API ---
# 호스트 8080이 이미 쓰이고 있으면 이 값만 바꾼다
API_PORT=8080

# 아래 URL은 앱을 로컬(IDE / ./gradlew test / java -jar)에서 띄울 때만 쓴다.
# docker compose로 띄우는 api 컨테이너는 compose가 db:3306으로 직접 넘긴다 —
# 컨테이너 안에서 127.0.0.1은 자기 자신이라 여기 값을 그대로 쓰면 DB를 못 찾는다.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/capture?connectionTimeZone=UTC

# ./gradlew test 전용. 개발용 DB를 건드리지 않도록 스키마를 나눈다
TEST_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/capture_test?connectionTimeZone=UTC
API_TOKEN=change-me-to-a-long-random-string
TZ=UTC

# --- Web ---
# 상대경로가 기본이다. 개발에서는 Vite 프록시가, 배포에서는 Caddy가 같은 출처로
# 넘겨주므로 CORS 설정이 필요 없다. 절대 URL로 바꾸면 서버에 CORS를 열어야 한다.
VITE_API_BASE_URL=/api/v1
