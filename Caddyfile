# 도메인 하나로 프론트와 API를 같이 서비스한다. 같은 출처라 CORS 설정이 필요 없다.
# Caddy가 Let's Encrypt 인증서를 알아서 받고 갱신한다 — 이 파일에 인증서 설정이 없는 게 정상이다.
{$DOMAIN} {
	encode zstd gzip

	# /api 는 백엔드로. 나머지는 정적 파일로.
	# 순서가 중요하다 — handle 블록은 위에서부터 먼저 맞는 것 하나만 실행된다
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:80
	}

	# HTTPS를 강제한다. 토큰이 헤더로 오가므로 평문으로 흘리면 안 된다
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
	}

	log {
		output stdout
		format console
	}
}
